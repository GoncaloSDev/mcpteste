// Configuração SÓ para verificação de tipos — nunca para compilar.
//
// Existe separada porque o tsconfig.json principal tem "rootDir": "src" e
// "include": ["src/**/*.ts"], que é exatamente o que o `npm run build` precisa:
// o dist/ tem de conter só o servidor, sem os scripts de teste ao lado.
//
// O efeito colateral era os scripts/ nunca passarem pelo compilador — corriam
// por tsx, que apaga os tipos sem os verificar. Um caminho errado ou uma
// propriedade que deixou de existir só apareciam ao correr o script.
//
// Daqui não sai ficheiro nenhum (noEmit); o rootDir passa a "." apenas para
// abranger as duas pastas.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
