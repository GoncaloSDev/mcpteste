# =============================================================================
# Copiar para .env e preencher o campo <definir>.
#   cp .env.example .env
#
# O .env é git-ignored. Só este ficheiro de exemplo é versionado.
# =============================================================================

# --- Ligação à base de dados --------------------------------------------------
# ATENÇÃO: aqui entra SÓ a connection string do utilizador de leitura.
# A DATABASE_URL_ADMIN do repositório agentsystem-db NUNCA deve ser colada aqui —
# este servidor não tem nenhuma razão para conseguir escrever.
#
# O utilizador `mcp_readonly` é criado automaticamente no primeiro arranque do
# container (ver agentsystem-db/docker/initdb/01-init-readonly.sh) e tem SELECT
# em todas as tabelas e mais nada.
#
# A porta é a POSTGRES_HOST_PORT do .env do agentsystem-db (5434 na configuração
# atual, não a 5432 por omissão do Postgres). A password é a READONLY_PASSWORD
# desse mesmo .env.
DATABASE_URL_READONLY=postgresql://mcp_readonly:<definir>@localhost:5434/distribuidor

# --- Escrita (OPCIONAL, opt-in) -----------------------------------------------
# Deixa esta variável COMENTADA para o servidor arrancar como sempre arrancou:
# 4 tools, nenhuma capaz de escrever. É o estado por omissão e o recomendado.
#
# Definida, o servidor regista mais cinco tools — insert_row, update_row,
# archive_row, restore_row e delete_row — que atuam sobre UMA linha de cada vez,
# identificada sempre pela chave primária. Não aceitam SQL.
#
# O archive_row é o "apagar" do dia-a-dia: esconde a linha de todas as consultas
# (por Row-Level Security do Postgres, não por filtros nas tools) sem a destruir,
# e o restore_row desfaz. O delete_row destrói mesmo — só funciona em linhas já
# arquivadas e leva atrás de si, em cascata, tudo o que lhes aponta.
#
# Só funcionam nas 12 tabelas de dados mestre (clientes, artigos, fornecedores,
# vendedores, precos_art, artfam, artsubfam, armazens, taxas_iva, cond_pag,
# escaloes_cli, doc_tipos). As 7 de movimento estão bloqueadas em dois sítios
# independentes: na whitelist do servidor e nos privilégios do Postgres.
#
# A password é a ESCRITA_PASSWORD do .env do agentsystem-db, e o role tem de ter
# sido criado por um `docker compose run --rm seed` com essa variável definida.
#
# NUNCA colar aqui a DATABASE_URL_ADMIN. O servidor verifica no arranque se a
# ligação é de superutilizador e RECUSA-SE a arrancar se for.
#
# ATENÇÃO: escrever na base faz as 50 respostas do EVAL-QUESTIONS.md deixarem de
# bater certo. Para as repor, volta a correr o seed.
# DATABASE_URL_WRITE=postgresql://mcp_escrita:<definir>@localhost:5434/distribuidor

# --- Limites de execução (Camada 3) -------------------------------------------
# Todos opcionais — os valores por omissão abaixo são os que o servidor usa se
# estas variáveis não estiverem definidas.

# Timeout por query, em milissegundos. Aplicado via statement_timeout do
# Postgres, portanto a query é mesmo cancelada no servidor.
MCP_TIMEOUT_MS=5000

# LIMIT acrescentado automaticamente às queries que não trazem um.
MCP_LIMITE_AUTOMATICO=200

# LIMIT explícito máximo aceite. Acima disto o pedido é recusado.
MCP_LIMITE_MAXIMO=500

# --- Transporte Streamable HTTP (só usado pelo `npm run start:http`) ----------
# O modo stdio — `npm run start` — ignora tudo o que está nesta secção.

# Porto do endpoint MCP. O endpoint é sempre /mcp.
MCP_HTTP_PORT=3000

# Interface onde o servidor escuta. O loopback por omissão NÃO é segurança a
# sério — é o mínimo para que um endpoint sem autenticação nenhuma (não há, nesta
# etapa) não fique exposto à rede local por distração. Pôr 0.0.0.0 aqui expõe as
# tools, e portanto a base de dados, a quem alcançar este porto.
MCP_HTTP_HOST=127.0.0.1

# Origens aceites além das locais (localhost, 127.0.0.1, [::1]), separadas por
# vírgula. Serve a proteção contra DNS rebinding que a especificação do MCP
# recomenda: sem ela, uma página aberta no browser desta máquina podia fazer POST
# ao endpoint e correr queries. Clientes nativos não enviam Origin e passam
# sempre — o que isto filtra são browsers.
# MCP_HTTP_ORIGENS=https://app.exemplo.pt
