# =============================================================================
# Copiar para .env e preencher o campo <definir>.
#   cp .env.example .env
#
# O .env é git-ignored. Só este ficheiro de exemplo é versionado.
# =============================================================================

# --- Ligação à base de dados --------------------------------------------------
# ATENÇÃO: aqui entra SÓ a connection string do utilizador de leitura.
# A DATABASE_URL_ADMIN do repositório agentsystem-db NUNCA deve ser colada aqui —
# este servidor não tem nenhuma razão para conseguir escrever.
#
# O utilizador `mcp_readonly` é criado automaticamente no primeiro arranque do
# container (ver agentsystem-db/docker/initdb/01-init-readonly.sh) e tem SELECT
# em todas as tabelas e mais nada.
#
# A porta é a POSTGRES_HOST_PORT do .env do agentsystem-db (5434 na configuração
# atual, não a 5432 por omissão do Postgres). A password é a READONLY_PASSWORD
# desse mesmo .env.
DATABASE_URL_READONLY=postgresql://mcp_readonly:<definir>@localhost:5434/distribuidor

# --- Limites de execução (Camada 3) -------------------------------------------
# Todos opcionais — os valores por omissão abaixo são os que o servidor usa se
# estas variáveis não estiverem definidas.

# Timeout por query, em milissegundos. Aplicado via statement_timeout do
# Postgres, portanto a query é mesmo cancelada no servidor.
MCP_TIMEOUT_MS=5000

# LIMIT acrescentado automaticamente às queries que não trazem um.
MCP_LIMITE_AUTOMATICO=200

# LIMIT explícito máximo aceite. Acima disto o pedido é recusado.
MCP_LIMITE_MAXIMO=500
